COOLIFY_API_BASE_URL=https://coolify.example.com/api/v1
COOLIFY_API_TOKEN=your-coolify-api-token
# Optional explicit env file. Use an absolute path in the MCP server runtime's OS format.
# COOLIFY_ENV_FILE=D:\\Data\\runtime\\coolify-mcp-server\\windows\\.env
# Optional id for the default profile (also registers hostname from API_BASE_URL as alias).
COOLIFY_ID=host
# Optional informational IPs (IPv4 or IPv6). These never change API_BASE_URL/routing.
# Leave unknown addresses empty; no DNS lookup or local/public failover is performed.
COOLIFY_EXTERNAL_IP=
COOLIFY_LOCAL_IP=
COOLIFY_TIMEOUT_MS=30000
COOLIFY_USER_AGENT=coolify-mcp-server/0.2.0
# Optional comma-separated profile ids used by Test/mcp_test.mjs.
COOLIFY_SMOKE_SERVER_IDS=host,hostkz

# Optional indexed profiles. Use server_id=dev or server_id=prod in MCP tool calls.
COOLIFY_1_ID=dev
COOLIFY_1_API_BASE_URL=https://coolify-dev.example.com/api/v1
COOLIFY_1_EXTERNAL_IP=
COOLIFY_1_LOCAL_IP=
COOLIFY_1_API_TOKEN=your-dev-coolify-api-token

COOLIFY_2_ID=prod
COOLIFY_2_API_BASE_URL=https://coolify-prod.example.com/api/v1
COOLIFY_2_API_TOKEN=your-prod-coolify-api-token

# Optional named profile style also works. This creates server_id=prod.
COOLIFY_PROD_API_BASE_URL=https://coolify-prod.example.com/api/v1
COOLIFY_PROD_EXTERNAL_IP=
COOLIFY_PROD_LOCAL_IP=
COOLIFY_PROD_API_TOKEN=your-prod-coolify-api-token

# Optional: allow non-GET/HEAD calls through coolify_api_request.
COOLIFY_ALLOW_RAW_WRITE=false
